<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE). The `admiral`
	     scheme brings the Jira OAuth redirect (admiral://oauth/jira) back to the app. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.pedro.admiral</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>admiral</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
